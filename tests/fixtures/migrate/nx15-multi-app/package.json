    "tslib": "^2.0.0",
    "zone.js": "~0.12.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^15.2.11",
    "@angular/compiler-cli": "^15.2.10",
    "@nrwl/angular": "15.9.7",
    "@nrwl/eslint-plugin-nx": "15.9.7",
    "@nrwl/jest": "15.9.7",
    "@nrwl/linter": "15.9.7",
    "@nrwl/workspace": "15.9.7",

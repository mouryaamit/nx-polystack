{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "moduleResolution": "node",
    "target": "ES2022",
    "module": "es2020",
    "lib": [
      "es2018",
      "dom"
    ],
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "typeRoots": [
      "node_modules/@types",
      "tools/types"
    ],
    "paths": {
      "@acme/shared": [
        "libs/shared/src/index.ts"
      ],
      "@acme/shared/*": [
        "libs/shared/src/*"
      ]
    }
  },
  "include": [
    "apps/**/*.ts",
    "libs/**/*.ts",
    "tools/types/**/*.d.ts"
  ]
}

{
  "name": "portal",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/portal/src",
  "prefix": "acme",
  "tags": [
    "scope:portal"
  ],
  "implicitDependencies": [
    "shared-styles"
  ],
  "targets": {
    "build": {
      "executor": "@nrwl/angular:webpack-browser",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/portal",
        "index": "apps/portal/src/index.html",
        "main": "apps/portal/src/main.ts",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "apps/portal/tsconfig.app.json",
        "styles": [
          "apps/portal/src/styles.scss"
        ],
        "stylePreprocessorOptions": {
          "includePaths": [
            "libs/shared/styles/src"
          ]
        }
      },
      "configurations": {
        "production": {
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@nrwl/angular:dev-server",
      "configurations": {
        "production": {
          "browserTarget": "portal:build:production"
        },
        "development": {
          "browserTarget": "portal:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": [
          "apps/portal/**/*.ts",
          "apps/portal/**/*.html"
        ]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/portal/jest.config.ts"
      }
    }
  }
}

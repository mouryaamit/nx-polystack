#!/usr/bin/env node
/**
 * tools/scripts/check-cycles.js — generated by nx-polystack (pstack infra).
 *
 * Fails when the Nx project graph has a dependency cycle that is not in
 * tools/config/allowed-cycles.json. Plain Node, no dependencies.
 *
 *   npm run check:cycles          reads the graph with `npx nx graph --file=<tmp>.json`
 *   node tools/scripts/check-cycles.js --graph=<file.json>
 *                                 reads an existing graph file instead
 *
 * A cycle is a group of projects that all depend on each other, directly or indirectly (a strongly
 * connected component), or a project that depends on itself. The allowlist holds one array of
 * project names per known cycle, in any order: [["app-a", "lib-b"], ...]. External npm packages
 * ("npm:" nodes) are ignored.
 */
'use strict';

const { execSync } = require('child_process');
const fs = require('fs');
const os = require('os');
const path = require('path');

const ALLOWLIST = path.join('tools', 'config', 'allowed-cycles.json');

/**
 * Project-to-project edges from `nx graph --file` output (Nx 17:
 * { graph: { nodes, dependencies: { [project]: [{ source, target, type }] } } }).
 * Only edges between workspace projects are kept.
 */
function readProjectGraph(json) {
  const graph = (json && json.graph) || json || {};
  const nodes = Object.keys(graph.nodes || {});
  const known = new Set(nodes);
  const deps = graph.dependencies || {};
  const edges = {};
  for (const name of nodes) {
    const targets = (deps[name] || [])
      .map((d) => d && d.target)
      .filter((t) => typeof t === 'string' && !t.startsWith('npm:') && known.has(t));
    edges[name] = [...new Set(targets)].sort();
  }
  return edges;
}

/**
 * Cycles in the graph (Tarjan's strongly connected components): every component with more than
 * one project, plus single projects that depend on themselves. Members sorted; cycles sorted.
 */
function findCycles(edges) {
  let index = 0;
  const indexOf = new Map();
  const low = new Map();
  const stack = [];
  const onStack = new Set();
  const found = [];

  const connect = (v) => {
    indexOf.set(v, index);
    low.set(v, index);
    index += 1;
    stack.push(v);
    onStack.add(v);
    for (const w of edges[v] || []) {
      if (!indexOf.has(w)) {
        connect(w);
        low.set(v, Math.min(low.get(v), low.get(w)));
      } else if (onStack.has(w)) {
        low.set(v, Math.min(low.get(v), indexOf.get(w)));
      }
    }
    if (low.get(v) === indexOf.get(v)) {
      const component = [];
      let w;
      do {
        w = stack.pop();
        onStack.delete(w);
        component.push(w);
      } while (w !== v);
      if (component.length > 1 || (edges[v] || []).includes(v)) found.push(component.sort());
    }
  };

  for (const v of Object.keys(edges).sort()) {
    if (!indexOf.has(v)) connect(v);
  }
  return found.sort((a, b) => key(a).localeCompare(key(b)));
}

function key(members) {
  return [...members].sort().join('\u0000');
}

/** Cycles that are not in the allowlist (compared as sets of project names). */
function newCycles(found, allowed) {
  const ok = new Set(allowed.map(key));
  return found.filter((c) => !ok.has(key(c)));
}

/** Allowlist entries that no longer match a cycle. */
function staleAllowed(found, allowed) {
  const present = new Set(found.map(key));
  return allowed.filter((c) => !present.has(key(c)));
}

/** One concrete loop through a cycle's members, for printing: a -> b -> c -> a. */
function cyclePath(edges, members) {
  const inCycle = new Set(members);
  const start = members[0];
  if ((edges[start] || []).includes(start)) return [start, start];
  const prev = new Map();
  const queue = [start];
  while (queue.length > 0) {
    const v = queue.shift();
    for (const w of edges[v] || []) {
      if (!inCycle.has(w)) continue;
      if (w === start) {
        const loop = [start];
        for (let x = v; x !== start; x = prev.get(x)) loop.splice(1, 0, x);
        return [...loop, start];
      }
      if (!prev.has(w)) {
        prev.set(w, v);
        queue.push(w);
      }
    }
  }
  return [...members, start];
}

function readAllowlist(root) {
  const file = path.join(root, ALLOWLIST);
  if (!fs.existsSync(file)) return [];
  const value = JSON.parse(fs.readFileSync(file, 'utf8'));
  const valid =
    Array.isArray(value) &&
    value.every((c) => Array.isArray(c) && c.length > 0 && c.every((p) => typeof p === 'string'));
  if (!valid) {
    throw new Error(
      `${ALLOWLIST} must be an array of arrays of project names, e.g. [["app-a", "lib-b"]].`,
    );
  }
  return value;
}

function readGraphFromNx() {
  const file = path.join(os.tmpdir(), `nx-graph-${process.pid}-${Date.now()}.json`);
  try {
    execSync(`npx nx graph --file="${file}"`, { stdio: ['ignore', 'pipe', 'pipe'] });
    return JSON.parse(fs.readFileSync(file, 'utf8'));
  } catch (err) {
    const out = [err.stdout, err.stderr].filter(Boolean).join('\n');
    throw new Error(`"nx graph" failed.${out ? `\n${out}` : ''}`);
  } finally {
    fs.rmSync(file, { force: true });
  }
}

function main(argv) {
  const graphArg = argv.find((a) => a.startsWith('--graph='));
  let edges;
  let allowed;
  try {
    const json = graphArg
      ? JSON.parse(fs.readFileSync(graphArg.slice('--graph='.length), 'utf8'))
      : readGraphFromNx();
    edges = readProjectGraph(json);
    allowed = readAllowlist(process.cwd());
  } catch (err) {
    console.error(`check-cycles: ${err.message}`);
    return 2;
  }

  const found = findCycles(edges);
  const fresh = newCycles(found, allowed);
  for (const c of staleAllowed(found, allowed)) {
    const entry = JSON.stringify(c);
    console.log(`check-cycles: ${entry} is no longer a cycle; remove it from ${ALLOWLIST}.`);
  }
  if (fresh.length === 0) {
    const known = found.length - fresh.length;
    console.log(
      `check-cycles: No new dependency cycles (${Object.keys(edges).length} projects` +
        `${known > 0 ? `, ${known} allowed cycle(s)` : ''}).`,
    );
    return 0;
  }
  console.error(`check-cycles: ${fresh.length} new dependency cycle(s):`);
  for (const c of fresh) console.error(`  ${cyclePath(edges, c).join(' -> ')}`);
  const example = JSON.stringify(fresh[0]);
  console.error(
    `\nBreak the cycle, or add a known, accepted one (e.g. ${example}) to ${ALLOWLIST}.`,
  );
  return 1;
}

module.exports = { readProjectGraph, findCycles, newCycles, staleAllowed, cyclePath };

if (require.main === module) {
  process.exitCode = main(process.argv.slice(2));
}

// Generated by nx-polystack (pstack infra).
// Lints, tests and builds the projects affected by the change, then checks for new project
// dependency cycles. Pull requests compare against their target branch (CHANGE_TARGET); builds of
// <%= baseBranch %> compare against the previous commit; other branches against <%= baseBranch %>.
<%_ if (flutter) { _%>
// The workspace has Flutter projects: Flutter must be on the agent's PATH.
<%_ } _%>
pipeline {
  agent any

  options {
    timestamps()
    timeout(time: 60, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  environment {
    BASE_BRANCH = "${env.CHANGE_TARGET ?: '<%= baseBranch %>'}"
    NX_BASE = "${env.CHANGE_TARGET ? 'origin/' + env.CHANGE_TARGET : (env.BRANCH_NAME == '<%= baseBranch %>' ? 'HEAD~1' : 'origin/<%= baseBranch %>')}"
  }

  stages {
    stage('Install') {
      steps {
<%_ if (flutter) { _%>
        sh 'flutter --version'
<%_ } _%>
        sh 'npm ci'
      }
    }

    stage('Lint, test, build (affected)') {
      steps {
        sh 'git fetch --no-tags origin "+refs/heads/${BASE_BRANCH}:refs/remotes/origin/${BASE_BRANCH}"'
        sh 'npx nx affected -t lint typecheck test build --parallel=3 --base="${NX_BASE}" --head=HEAD'
      }
    }

    stage('Dependency cycles') {
      steps {
        sh 'npm run check:cycles'
      }
    }
  }
}

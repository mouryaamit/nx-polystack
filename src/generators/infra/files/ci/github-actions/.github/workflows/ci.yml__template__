# Generated by nx-polystack (pstack infra). Lint, test and build what changed, then check for
# new project dependency cycles.
<%_ if (flutter) { _%>
# The workspace has Flutter projects, so the Flutter SDK (stable channel) is set up as well.
<%_ } else { _%>
# No Flutter projects when this was generated: after adding one, run `pstack infra --with=ci --force`
# (or `--flutter=on`) to add the Flutter setup step.
<%_ } _%>
name: CI

on:
  pull_request:
  push:
    branches: [<%= baseBranch %>]

permissions:
  actions: read
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  main:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/setup-node@v4
        with:
          node-version-file: .nvmrc
          cache: npm
<%_ if (flutter) { _%>
      - uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true
<%_ } _%>
<%_ if (pluginFromGithub) { _%>
      # The nx-polystack plugin is installed from a private GitHub repo. Add a repository secret
      # PSTACK_REPO_TOKEN (a token that can read that repo) so npm ci can fetch it.
      - name: Allow npm to fetch the private nx-polystack plugin
        env:
          PSTACK_REPO_TOKEN: ${{ secrets.PSTACK_REPO_TOKEN }}
        run: |
          if [ -n "$PSTACK_REPO_TOKEN" ]; then
            git config --global url."https://x-access-token:${PSTACK_REPO_TOKEN}@github.com/".insteadOf "ssh://git@github.com/"
            git config --global --add url."https://x-access-token:${PSTACK_REPO_TOKEN}@github.com/".insteadOf "git@github.com:"
          fi
<%_ } _%>
      - run: npm ci
<%_ if (ciCache) { _%>
      - name: Nx cache
        uses: actions/cache@v4
        with:
          path: <%= cacheDirectory %>
          key: nx-${{ runner.os }}-${{ hashFiles('package-lock.json') }}-${{ github.sha }}
          restore-keys: |
            nx-${{ runner.os }}-${{ hashFiles('package-lock.json') }}-
            nx-${{ runner.os }}-
<%_ } _%>
      - uses: nrwl/nx-set-shas@v4
        with:
          main-branch-name: <%= baseBranch %>
      - run: npx nx affected -t lint typecheck test build --parallel=3
      - run: npm run check:cycles

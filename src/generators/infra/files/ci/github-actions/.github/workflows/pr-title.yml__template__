# Generated by nx-polystack (pstack infra). The pull request title becomes the squash-merge
# commit message, so it must pass the same commitlint rules as every commit.
name: PR title

on:
  pull_request:
    types: [opened, edited, synchronize]

permissions:
  contents: read

jobs:
  commitlint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
      - uses: actions/setup-node@v5
        with:
          node-version-file: .nvmrc
          cache: npm
<%_ if (pluginFromGithub) { _%>
      # See ci.yml: PSTACK_REPO_TOKEN lets npm ci fetch the private nx-polystack plugin.
      - name: Allow npm to fetch the private nx-polystack plugin
        env:
          PSTACK_REPO_TOKEN: ${{ secrets.PSTACK_REPO_TOKEN }}
        run: |
          if [ -n "$PSTACK_REPO_TOKEN" ]; then
            git config --global url."https://x-access-token:${PSTACK_REPO_TOKEN}@github.com/".insteadOf "ssh://git@github.com/"
            git config --global --add url."https://x-access-token:${PSTACK_REPO_TOKEN}@github.com/".insteadOf "git@github.com:"
          fi
<%_ } _%>
      - run: npm ci
      - name: Check the title with commitlint
        env:
          TITLE: ${{ github.event.pull_request.title }}
        run: echo "$TITLE" | npx --no-install commitlint

# Generated by nx-polystack (pstack infra). Upgrades dependencies on a schedule and opens (or
# updates) a pull request with the result.
#
# Needs:
<%_ if (pluginFromGithub) { _%>
# - Repository secret PSTACK_REPO_TOKEN: a token that can read <%= pluginRepo %> (the plugin
#   repo is private). Used by npm to install the plugin and by gh to find its latest release.
<%_ } _%>
# - Settings > Actions > General > "Allow GitHub Actions to create and approve pull requests".
# Pull requests opened with the default GITHUB_TOKEN do not start other workflows; close and
# reopen the pull request (or push to its branch) to run CI on it.
name: Dependency upgrade

on:
  schedule:
    - cron: '<%= upgradeCron %>' # <%= upgradeSchedule %>, UTC
  workflow_dispatch:

permissions:
  contents: write
  pull-requests: write

jobs:
  upgrade:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
        with:
          ref: <%= baseBranch %>
      - uses: actions/setup-node@v5
        with:
          node-version-file: .nvmrc
          cache: npm
<%_ if (pluginFromGithub) { _%>
      - name: Allow npm to fetch the private nx-polystack plugin
        env:
          PSTACK_REPO_TOKEN: ${{ secrets.PSTACK_REPO_TOKEN }}
        run: |
          if [ -z "$PSTACK_REPO_TOKEN" ]; then
            echo "::error::Add the PSTACK_REPO_TOKEN repository secret (read access to <%= pluginRepo %>)."
            exit 1
          fi
          git config --global url."https://x-access-token:${PSTACK_REPO_TOKEN}@github.com/".insteadOf "ssh://git@github.com/"
          git config --global --add url."https://x-access-token:${PSTACK_REPO_TOKEN}@github.com/".insteadOf "git@github.com:"
<%_ } _%>
      - run: npm ci
      - name: Upgrade nx-polystack to its latest release
<%_ if (pluginFromGithub) { _%>
        env:
          GH_TOKEN: ${{ secrets.PSTACK_REPO_TOKEN }}
        run: |
          latest=$(gh release view --repo <%= pluginRepo %> --json tagName --jq .tagName)
          npx --no-install pstack update --to="${latest#v}" --allow-dirty
<%_ } else { _%>
        run: |
          latest=$(npm view <%= pluginName %> version)
          npx --no-install pstack update --to="${latest}" --allow-dirty
<%_ } _%>
<%_ if (upgradeScope === 'nx-minor') { _%>
      - name: Upgrade Nx within its current major
        run: |
          major=$(node -p "require('nx/package.json').version.split('.')[0]")
          npx nx migrate "nx@${major}"
          npm install
          if [ -f migrations.json ]; then
            npx nx migrate --run-migrations
            rm migrations.json
          fi
<%_ } _%>
      - uses: peter-evans/create-pull-request@v8
        with:
          branch: chore/dependency-upgrade
          base: <%= baseBranch %>
          title: 'chore(deps): scheduled dependency upgrade'
          commit-message: 'chore(deps): scheduled dependency upgrade'
          body: |
            Scheduled dependency upgrade (<%= upgradeScope %>), opened by the dependency-upgrade workflow.

            Review the changes and the CI result before merging.
          delete-branch: true

# Flutter-web nginx configuration for <%= name %>
# Generated by @mouryaamit/nx-polystack — do not edit unless necessary.
# CSP is tuned for Flutter web (CanvasKit + WebAssembly) — do not tighten without testing.

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Serve Flutter web assets with correct MIME types
    location / {
        try_files $uri $uri/ /index.html;
    }

    # WebAssembly — required for CanvasKit renderer
    location ~* \.wasm$ {
        add_header Content-Type application/wasm;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Long-lived cache for hashed assets
    location ~* \.(js|css|png|jpg|jpeg|svg|ico|woff2?)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";
    add_header Referrer-Policy "strict-origin-when-cross-origin";

    # CSP — Flutter CanvasKit requires wasm-unsafe-eval and blob: for worker scripts.
    # Tighten 'unsafe-inline' styles only after verifying no inline styles are injected.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src blob:; frame-ancestors 'none';" always;
}

<% } else if (standalone) { %>import { RouterOutlet } from '@angular/router';
<% } %>
@Component({
  selector: 'app-root',
  templateUrl: './app.component.html',
  styleUrls: ['./app.component.scss'],
  changeDetection: ChangeDetectionStrategy.OnPush,

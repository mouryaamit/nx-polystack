<% } %><% if (standaloneTrue) { %>  standalone: true,
<% } %><% if (standalone) { %>  imports: [<%= ionic ? 'IonApp, IonRouterOutlet' : 'RouterOutlet' %>],
<% } %>})
export class AppComponent {}

<% if (provideHttp) { %>import { provideHttpClient, withInterceptorsFromDi } from '@angular/common/http';
<% } else { %>import { HttpClientModule } from '@angular/common/http';
<% } %>import { NgModule } from '@angular/core';
import { BrowserModule } from '@angular/platform-browser';
import { RouteReuseStrategy } from '@angular/router';
import { IonicModule, IonicRouteStrategy } from '<%= ionicImport %>';

import { AppRoutingModule } from './app-routing.module';
import { AppComponent } from './app.component';

@NgModule({
  declarations: [AppComponent],
<% if (provideHttp) { %>  imports: [BrowserModule, IonicModule.forRoot(), AppRoutingModule],
  providers: [
    { provide: RouteReuseStrategy, useClass: IonicRouteStrategy },
    provideHttpClient(withInterceptorsFromDi()),
  ],
<% } else { %>  imports: [BrowserModule, HttpClientModule, IonicModule.forRoot(), AppRoutingModule],
  providers: [{ provide: RouteReuseStrategy, useClass: IonicRouteStrategy }],
<% } %>  bootstrap: [AppComponent],
})
export class AppModule {}

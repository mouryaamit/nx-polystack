import { NgModule } from '@angular/core';
import { EffectsModule } from '@ngrx/effects';
import { StoreModule } from '@ngrx/store';

import { <%= className %>Effects } from './<%= fileName %>.effects';
import { <%= constantName %>_FEATURE_KEY, <%= propertyName %>Reducer } from './<%= fileName %>.reducer';

/**
 * Registers the <%= title %> feature state. The app must import `StoreModule.forRoot({})` and
 * `EffectsModule.forRoot([])` once.
 */
@NgModule({
  imports: [
    StoreModule.forFeature(<%= constantName %>_FEATURE_KEY, <%= propertyName %>Reducer),
    EffectsModule.forFeature([<%= className %>Effects]),
  ],
})
export class <%= className %>StateModule {}
